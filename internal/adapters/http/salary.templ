package http

import (
	"fmt"

	"barbershop/internal/domain"
)

templ SalaryPage(user domain.User, summary domain.SalarySummary, fromStr string, toStr string) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Something · DRFT Barbershop</title>
			<meta name="theme-color" content="#000000"/>
			<link rel="icon" type="image/png" href="/static/favicon.png"/>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body class="app-page">
			<div class="app-shell">
				<nav class="app-nav">
					<a href="/" class="app-nav-brand">DRFT</a>
					<div class="app-nav-tabs">
						<a href="/me">My page</a>
						<a href="/me/salary" class="active">Salary</a>
					</div>
					<div class="app-nav-user">
						<span>{ user.FullName }</span>
						<form method="post" action="/logout">
							<button type="submit">Logout</button>
						</form>
					</div>
				</nav>
				<main class="app-main">
					<header class="app-header">
						<h1 class="app-title">Salary</h1>
						<p class="app-sub">
							From <strong>{ summary.From.Format("Jan 2") }</strong> to <strong>{ summary.To.Format("Jan 2, 2006") }</strong>
						</p>
					</header>
					<!-- Filter -->
					<section class="panel">
						<div class="panel-head">
							<h2 class="panel-title">Date range</h2>
						</div>
						<div class="panel-body">
							<form method="get" action="/me/salary" class="inline-form">
								<label class="inline-label">
									<span>From</span>
									<input type="date" name="from" value={ fromStr } required/>
								</label>
								<label class="inline-label">
									<span>To</span>
									<input type="date" name="to" value={ toStr } required/>
								</label>
								<button type="submit">Show</button>
							</form>
						</div>
					</section>
					<!-- Summary stats -->
					<section class="stats-row">
						<div class="stat-card">
							<div class="stat-label">Working days</div>
							<div class="stat-value">{ fmt.Sprintf("%d", len(summary.Days)) }</div>
						</div>
						<div class="stat-card">
							<div class="stat-label">Gross salary</div>
							<div class="stat-value">{ domain.FormatCentavos(summary.GrossSalary) }</div>
						</div>
						<div class="stat-card">
							<div class="stat-label">Advances</div>
							<div class="stat-value">{ domain.FormatCentavos(summary.AdvancesTotal) }</div>
						</div>
						<div class="stat-card stat-card-accent">
							<div class="stat-label">Take home</div>
							<div class="stat-value">{ domain.FormatCentavos(summary.TakeHome) }</div>
						</div>
					</section>
					<!-- Daily breakdown -->
					<section class="panel">
						<div class="panel-head">
							<h2 class="panel-title">Daily breakdown</h2>
							<p class="panel-sub">
								Daily minimum { domain.FormatCentavos(summary.DailyFloor) } · commission { fmt.Sprintf("%d%%", domain.CommissionPercent) }
							</p>
						</div>
						if len(summary.Days) == 0 {
							<div class="empty-state">
								<p>No working days in this range.</p>
							</div>
						} else {
							<table class="data-table">
								<thead>
									<tr>
										<th style="width: 180px;">Date</th>
										<th style="width: 80px;">Cuts</th>
										<th style="width: 130px;">List total</th>
										<th style="width: 130px;">Commission</th>
										<th style="width: 130px;">Paid</th>
									</tr>
								</thead>
								<tbody>
									for _, d := range summary.Days {
										<tr>
											<td>{ d.Date.Format("Mon, Jan 2") }</td>
											<td class="data-mono">{ fmt.Sprintf("%d", d.HaircutCount) }</td>
											<td>{ domain.FormatCentavos(d.ListTotal) }</td>
											<td>{ domain.FormatCentavos(d.Commission) }</td>
											<td>
												<span class="data-strong">{ domain.FormatCentavos(d.Paid) }</span>
												if d.FloorApplied {
													<br/>
													<small class="floor-tag">minimum applied</small>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</section>
					<!-- Totals box -->
					if len(summary.Days) > 0 {
						<div class="totals-box">
							<div class="totals-row">
								<span>Gross salary</span>
								<strong>{ domain.FormatCentavos(summary.GrossSalary) }</strong>
							</div>
							<div class="totals-row">
								<span>Cash advances</span>
								<strong>− { domain.FormatCentavos(summary.AdvancesTotal) }</strong>
							</div>
							<div class="totals-row totals-row-final">
								<span>Take home</span>
								<strong>{ domain.FormatCentavos(summary.TakeHome) }</strong>
							</div>
						</div>
					}
				</main>
			</div>
		</body>
	</html>
}
