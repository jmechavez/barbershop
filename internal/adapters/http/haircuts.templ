package http

import (
	"fmt"

	"barbershop/internal/domain"
)

templ HaircutsPage(
	admin domain.User,
	barbers []domain.User,
	haircuts []domain.Haircut,
	barberName map[int]string,
	serviceName map[int]string,
	fromStr, toStr string,
	selectedBarberID int,
) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Haircuts · DRFT Barbershop</title>
			<meta name="theme-color" content="#000000"/>
			<link rel="icon" type="image/png" href="/static/favicon.png"/>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/app.js" defer></script>
		</head>
		<body class="app-page">
			<div class="app-shell">

				<nav class="app-nav">
					<a href="/" class="app-nav-brand">DRFT</a>
					<div class="app-nav-tabs">
						<a href="/admin">Admin</a>
						<a href="/counter">Counter</a>
						<a href="/admin/haircuts" class="active">Haircuts</a>
						<a href="/admin/cash-advances">Advances</a>
					</div>
					<div class="app-nav-user">
						<span>{ admin.FullName }</span>
						<form method="post" action="/logout">
							<button type="submit">Logout</button>
						</form>
					</div>
				</nav>

				<main class="app-main">

					<header class="app-header">
						<h1 class="app-title">All haircuts</h1>
						<p class="app-sub">
							From <strong>{ fromStr }</strong> to <strong>{ toStr }</strong>
						</p>
					</header>

					<!-- Filter -->
					<section class="panel">
						<div class="panel-head">
							<h2 class="panel-title">Filter</h2>
						</div>
						<div class="panel-body">
							<form method="get" action="/admin/haircuts" class="inline-form">
								<label class="inline-label">
									<span>Barber</span>
									<select name="barber_id">
										if selectedBarberID == 0 {
											<option value="0" selected>All barbers</option>
										} else {
											<option value="0">All barbers</option>
										}
										for _, b := range barbers {
											if b.ID == selectedBarberID {
												<option value={ fmt.Sprintf("%d", b.ID) } selected>{ b.FullName }</option>
											} else {
												<option value={ fmt.Sprintf("%d", b.ID) }>{ b.FullName }</option>
											}
										}
									</select>
								</label>
								<label class="inline-label">
									<span>From</span>
									<input type="date" name="from" value={ fromStr } required/>
								</label>
								<label class="inline-label">
									<span>To</span>
									<input type="date" name="to" value={ toStr } required/>
								</label>
								<button type="submit">Show</button>
							</form>
						</div>
					</section>

					<!-- Results -->
					<section class="panel">
						<div class="panel-head">
							<h2 class="panel-title">Results</h2>
							<p class="panel-sub">
								{ fmt.Sprintf("%d", len(haircuts)) } haircuts
								if len(haircuts) > 0 {
									· list { domain.FormatCentavos(domain.SumListCentavos(haircuts)) }
									· net { domain.FormatCentavos(domain.SumNetCentavos(haircuts)) }
								}
							</p>
						</div>

						<div class="panel-body panel-body-flush">
							if len(haircuts) == 0 {
								<div class="empty-state">
									<p>No haircuts in this range.</p>
								</div>
							} else {
								<table class="data-table">
									<thead>
										<tr>
											<th style="width: 160px;">Date &amp; time</th>
											<th>Barber</th>
											<th>Service</th>
											<th style="width: 110px;">Price</th>
											<th style="width: 140px;">Discount</th>
											<th style="width: 110px;">Net</th>
											<th>Payments</th>
										</tr>
									</thead>
									<tbody>
										for _, h := range haircuts {
											<tr>
												<td class="data-mono" data-label="Date">
													{ h.CreatedAt.Format("Jan 2, 2006") }
													<br/>
													<small>{ h.CreatedAt.Format("15:04") }</small>
												</td>
												<td data-label="Barber">{ barberName[h.BarberID] }</td>
												<td data-label="Service">{ serviceName[h.ServiceID] }</td>
												<td data-label="Price">{ domain.FormatCentavos(h.PriceCentavos) }</td>
												<td data-label="Discount">
													if h.DiscountCentavos > 0 {
														<span class="data-strong">{ domain.FormatCentavos(h.DiscountCentavos) }</span>
														if h.DiscountReason != "" {
															<br/><small>({ h.DiscountReason })</small>
														}
													} else {
														<span class="data-dim">—</span>
													}
												</td>
												<td class="data-strong" data-label="Net">{ domain.FormatCentavos(h.NetCentavos) }</td>
												<td data-label="Payments">
													if len(h.Payments) == 0 {
														<small>free</small>
													} else {
														for i, p := range h.Payments {
															if i > 0 {
																<br/>
															}
															<span class="pay-tag">{ string(p.Method) }</span>
															{ domain.FormatCentavos(p.AmountCentavos) }
														}
													}
												</td>
											</tr>
										}
									</tbody>
								</table>
							}
						</div>
					</section>

				</main>
			</div>
		</body>
	</html>
}