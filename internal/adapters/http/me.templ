package http

import (
	"fmt"

	"barbershop/internal/domain"
)

templ MePage(user domain.User, haircuts []domain.Haircut, serviceName map[int]string) {
	<!DOCTYPE html>
	<html>
		<head>
			<title>My page — Barbershop</title>
			<style>
				body { font-family: sans-serif; max-width: 800px; margin: 40px auto; }
				.topbar { text-align: right; margin-bottom: 20px; }
				.topbar form { display: inline; margin: 0; padding: 0; }
				.topbar button { background: none; border: none; color: #0000ee;
				                 text-decoration: underline; cursor: pointer;
				                 font: inherit; padding: 0; }
				table { border-collapse: collapse; width: 100%; margin-top: 16px; }
				th, td { border: 1px solid #ccc; padding: 8px; text-align: left; vertical-align: middle; }
				.summary { margin-top: 16px; font-size: 1.1em; }
				.summary strong { font-size: 1.3em; }
				small { color: #666; }
			</style>
		</head>
		<body>
			<div class="topbar">
				<span>{ user.FullName }</span>
				<form method="post" action="/logout">
					<button type="submit">Logout</button>
				</form>
			</div>

			<h1>Hello, { user.FullName }</h1>
			<p>Today is a good day to look sharp.</p>

			<h2>Today</h2>

			if len(haircuts) == 0 {
				<p>No haircuts recorded yet today.</p>
			} else {
				<p class="summary">
					Haircuts: <strong>{ fmt.Sprintf("%d", len(haircuts)) }</strong>
					&nbsp;·&nbsp;
					Total list price: <strong>{ domain.FormatCentavos(domain.SumListCentavos(haircuts)) }</strong>
					&nbsp;·&nbsp;
					Net collected: <strong>{ domain.FormatCentavos(domain.SumNetCentavos(haircuts)) }</strong>
				</p>

				<table>
					<tr>
						<th>Service</th>
						<th style="width: 90px;">Price</th>
						<th style="width: 130px;">Discount</th>
						<th style="width: 90px;">Net</th>
						<th>Payments</th>
					</tr>
					for _, h := range haircuts {
						<tr>
							<td>{ serviceName[h.ServiceID] }</td>
							<td>{ domain.FormatCentavos(h.PriceCentavos) }</td>
							<td>
								if h.DiscountCentavos > 0 {
									{ domain.FormatCentavos(h.DiscountCentavos) }
									if h.DiscountReason != "" {
										<br/><small>({ h.DiscountReason })</small>
									}
								} else {
									—
								}
							</td>
							<td>{ domain.FormatCentavos(h.NetCentavos) }</td>
							<td>
								if len(h.Payments) == 0 {
									<small>(free)</small>
								} else {
									for i, p := range h.Payments {
										if i > 0 {
											<br/>
										}
										{ string(p.Method) }: { domain.FormatCentavos(p.AmountCentavos) }
									}
								}
							</td>
						</tr>
					}
				</table>
			}

			<p style="margin-top: 32px;"><a href="/">Back to shop</a></p>
		</body>
	</html>
}