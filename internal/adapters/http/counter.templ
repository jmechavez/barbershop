package http

import (
	"fmt"

	"barbershop/internal/domain"
)

templ CounterPage(
	admin domain.User,
	barbers []domain.User,
	services []domain.Service,
	haircuts []domain.Haircut,
	barberName map[int]string,
	serviceName map[int]string,
	errorMsg string,
) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Counter · DRFT Barbershop</title>
			<meta name="theme-color" content="#000000"/>
			<link rel="icon" type="image/png" href="/static/favicon.png"/>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/app.js" defer></script>
		</head>
		<body class="app-page">
			<div class="app-shell">

				<nav class="app-nav">
					<a href="/" class="app-nav-brand">DRFT</a>
					<div class="app-nav-tabs">
						<a href="/admin">Admin</a>
						<a href="/counter" class="active">Counter</a>
						<a href="/admin/haircuts">Haircuts</a>
						<a href="/admin/cash-advances">Advances</a>
					</div>
					<div class="app-nav-user">
						<span>{ admin.FullName }</span>
						<form method="post" action="/logout">
							<button type="submit">Logout</button>
						</form>
					</div>
				</nav>

				<main class="app-main">

					<header class="app-header">
						<h1 class="app-title">Counter</h1>
						<p class="app-sub">Record a haircut</p>
					</header>

					<section class="panel">
						<div class="panel-head">
							<h2 class="panel-title">New haircut</h2>
						</div>

						<div class="panel-body">

							if errorMsg != "" {
								<p class="error">{ errorMsg }</p>
							}

							<form method="post" action="/counter/haircuts" id="counter-form" class="counter-form">

								<div class="form-row">
									<label class="inline-label">
										<span>Barber</span>
										<select name="barber_id" required>
											for _, b := range barbers {
												<option value={ fmt.Sprintf("%d", b.ID) }>{ b.FullName }</option>
											}
										</select>
									</label>

									<label class="inline-label inline-label-grow">
										<span>Service</span>
										<select name="service_id" id="service-select" required>
											for _, s := range services {
												<option value={ fmt.Sprintf("%d", s.ID) }
												        data-price={ fmt.Sprintf("%d", s.PriceCentavos) }>
													{ s.Name } — { s.FormatPrice() }
												</option>
											}
										</select>
									</label>

									<label class="inline-label">
										<span>Date &amp; time</span>
										<input type="datetime-local" name="created_at" id="created-at" required/>
									</label>
								</div>

								<div class="form-row form-row-discount">
									<label class="inline-label">
										<span>Discount (₱)</span>
										<input type="number" name="discount_pesos" id="discount-input" min="0" step="1" value="0"/>
									</label>

									<div class="quick-discount">
										<span class="quick-discount-label">Quick</span>
										<button type="button" class="quick-btn" data-discount="50">₱50</button>
										<button type="button" class="quick-btn quick-btn-free" data-discount="free">Free</button>
										<button type="button" class="quick-btn quick-btn-clear" data-discount="clear">Clear</button>
									</div>

									<label class="inline-label inline-label-grow inline-label-reason">
										<span>Discount reason</span>
										<textarea name="discount_reason" rows="3" placeholder="Student, Senior, VIP, Birthday..."></textarea>
									</label>
								</div>

								<div class="payment-section">
									<div class="payment-head">
										<span class="payment-head-label">Payment</span>
										<span class="payment-head-hint">Tap a card to enter an amount</span>
									</div>

									<div class="payment-cards">
										<label class="pay-card">
											<span class="pay-card-name">GCash</span>
											<input type="number" name="pay_gcash" class="pay-input" min="0" step="1" value="0" data-pay="gcash"/>
											<span class="pay-card-currency">₱</span>
										</label>

										<label class="pay-card">
											<span class="pay-card-name">Maribank</span>
											<input type="number" name="pay_maribank" class="pay-input" min="0" step="1" value="0" data-pay="maribank"/>
											<span class="pay-card-currency">₱</span>
										</label>

										<label class="pay-card">
											<span class="pay-card-name">Cash</span>
											<input type="number" name="pay_cash" class="pay-input" min="0" step="1" value="0" data-pay="cash"/>
											<span class="pay-card-currency">₱</span>
										</label>
									</div>

									<div class="payment-totals" id="payment-totals">
										<div class="pay-total-row">
											<span class="pay-total-label">Net due</span>
											<span class="pay-total-value" id="net-due">₱0</span>
										</div>
										<div class="pay-total-row">
											<span class="pay-total-label">Paid</span>
											<span class="pay-total-value" id="total-paid">₱0</span>
										</div>
										<div class="pay-total-row pay-total-final" id="remaining-row">
											<span class="pay-total-label">Remaining</span>
											<span class="pay-total-value" id="remaining">₱0</span>
										</div>
									</div>
								</div>

								<div class="form-actions">
									<button type="submit"
									        class="js-confirm"
									        data-confirm="Record this haircut?">
										Record haircut
									</button>
								</div>

							</form>
						</div>
					</section>

					<section class="panel">
						<div class="panel-head">
							<h2 class="panel-title">Today</h2>
							<p class="panel-sub">
								{ fmt.Sprintf("%d", len(haircuts)) } haircuts · net { domain.FormatCentavos(domain.SumNetCentavos(haircuts)) }
							</p>
						</div>

						<div class="panel-body panel-body-flush">
							if len(haircuts) == 0 {
								<div class="empty-state">
									<p>No haircuts recorded yet today.</p>
								</div>
							} else {
								<table class="data-table">
									<thead>
										<tr>
											<th style="width: 90px;">Time</th>
											<th>Barber</th>
											<th>Service</th>
											<th style="width: 110px;">Price</th>
											<th style="width: 140px;">Discount</th>
											<th style="width: 100px;">Net</th>
											<th>Payments</th>
										</tr>
									</thead>
									<tbody>
										for _, h := range haircuts {
											<tr>
												<td class="data-mono" data-label="Time">{ h.CreatedAt.Format("15:04") }</td>
												<td data-label="Barber">{ barberName[h.BarberID] }</td>
												<td data-label="Service">{ serviceName[h.ServiceID] }</td>
												<td data-label="Price">{ domain.FormatCentavos(h.PriceCentavos) }</td>
												<td data-label="Discount">
													if h.DiscountCentavos > 0 {
														<span class="data-strong">{ domain.FormatCentavos(h.DiscountCentavos) }</span>
														if h.DiscountReason != "" {
															<br/><small>({ h.DiscountReason })</small>
														}
													} else {
														<span class="data-dim">—</span>
													}
												</td>
												<td class="data-strong" data-label="Net">{ domain.FormatCentavos(h.NetCentavos) }</td>
												<td data-label="Payments">
													if len(h.Payments) == 0 {
														<small>free</small>
													} else {
														for i, p := range h.Payments {
															if i > 0 {
																<br/>
															}
															<span class="pay-tag">{ string(p.Method) }</span>
															{ domain.FormatCentavos(p.AmountCentavos) }
														}
													}
												</td>
											</tr>
										}
									</tbody>
								</table>
							}
						</div>
					</section>

				</main>
			</div>

			<!-- Confirm modal -->
			<div class="confirm-overlay" id="confirmModal" aria-hidden="true">
				<div class="confirm-box">
					<p class="confirm-message" id="confirmMessage">Are you sure?</p>
					<div class="confirm-actions">
						<button type="button" class="btn-secondary" id="confirmCancel">Cancel</button>
						<button type="button" class="btn-danger" id="confirmOk">Confirm</button>
					</div>
				</div>
			</div>
		</body>
	</html>
}