package http

import (
	"fmt"

	"barbershop/internal/domain"
)

templ AdminHome(user domain.User, services []domain.Service, users []domain.User, advances []domain.CashAdvance, barberName map[int]string) {
	<!DOCTYPE html>
	<html>
		<head>
			<title>Admin — Barbershop</title>
			<script src="https://unpkg.com/htmx.org@2.0.3"></script>
			<style>
				body { font-family: sans-serif; max-width: 900px; margin: 40px auto; }
				table { border-collapse: collapse; width: 100%; margin-top: 16px; }
				th, td { border: 1px solid #ccc; padding: 8px; text-align: left; vertical-align: middle; }
				input[type=text], input[type=email], input[type=password] { width: 100%; box-sizing: border-box; padding: 4px; }
				input[type=number] { width: 90px; padding: 4px; }
				section { margin-top: 32px; }
				small { color: #666; }
			</style>
		</head>
		<body>
			<h1>Admin</h1>
			<p>Signed in as { user.FullName } ({ user.Email }) — { string(user.Role) }</p>

			<section>
				<h2>Staff</h2>
				<table>
					<tr>
						<th style="width: 40px;">ID</th>
						<th>Name</th>
						<th>Email</th>
						<th style="width: 100px;">Role</th>
						<th style="width: 130px;">Daily minimum</th>
					</tr>
					for _, u := range users {
						<tr>
							<td>{ fmt.Sprintf("%d", u.ID) }</td>
							<td>{ u.FullName }</td>
							<td>{ u.Email }</td>
							<td>{ string(u.Role) }</td>
							<td>{ domain.FormatCentavos(u.DailyFloorCentavos) }</td>
						</tr>
					}
				</table>

				<h3>Add a staff account</h3>
				<form method="post" action="/admin/users">
					<label>
						Full name
						<input type="text" name="full_name" required
						       style="width: 200px; box-sizing: border-box; padding: 4px;"/>
					</label>
					<label>
						Email
						<input type="email" name="email" required
						       style="width: 200px; box-sizing: border-box; padding: 4px;"/>
					</label>
					<label>
						Password
						<input type="password" name="password" required
						       style="width: 160px; box-sizing: border-box; padding: 4px;"/>
					</label>
					<label>
						Role
						<select name="role">
							<option value="barber">barber</option>
							<option value="admin">admin</option>
						</select>
					</label>
					<label>
						Daily minimum (pesos)
						<input type="number" name="daily_floor_pesos" min="0" value="500" required
						       style="width: 90px; padding: 4px;"/>
					</label>
					<button type="submit">Create</button>
				</form>
			</section>

			<section>
				<h2>Cash advances (last 30 days)</h2>
				if len(advances) == 0 {
					<p>No cash advances in the last 30 days.</p>
				} else {
					<table>
						<tr>
							<th style="width: 70px;">ID</th>
							<th>Barber</th>
							<th style="width: 100px;">Amount</th>
							<th style="width: 160px;">Date</th>
							<th>Note</th>
						</tr>
						for _, a := range advances {
							<tr>
								<td>{ fmt.Sprintf("%d", a.ID) }</td>
								<td>{ barberName[a.BarberID] }</td>
								<td>{ domain.FormatCentavos(a.AmountCentavos) }</td>
								<td>{ a.TakenAt.Format("Jan 2, 2006") }</td>
								<td>{ a.Note }</td>
							</tr>
						}
					</table>
				}

				<h3>Record a cash advance</h3>
				<form method="post" action="/admin/cash-advances">
					<label>
						Barber
						<select name="barber_id" required>
							for _, u := range users {
								if u.Role == domain.RoleBarber {
									<option value={ fmt.Sprintf("%d", u.ID) }>{ u.FullName }</option>
								}
							}
						</select>
					</label>
					<label style="margin-left: 20px;">
						Amount (pesos)
						<input type="number" name="amount_pesos" min="1" step="1" required
						       style="width: 100px; padding: 4px;"/>
					</label>
					<label style="margin-left: 20px;">
						Note
						<input type="text" name="note" placeholder="Reason (optional)"
						       style="width: 240px; padding: 4px;"/>
					</label>
					<button type="submit" style="margin-left: 20px;">Record</button>
				</form>
			</section>

			<section>
				<h2>Services</h2>
				<table>
					<tr>
						<th style="width: 40px;">ID</th>
						<th>Name</th>
						<th style="width: 120px;">Price</th>
						<th style="width: 120px;">Formatted</th>
						<th style="width: 90px;"></th>
					</tr>
					for _, s := range services {
						@ServiceRow(s)
					}
				</table>

				<h3>Add a service</h3>
				<form method="post" action="/admin/services">
					<label>
						Name
						<input type="text" name="name" required
						       style="width: 200px; box-sizing: border-box; padding: 4px;"/>
					</label>
					<label>
						Price (pesos)
						<input type="number" name="price_pesos" min="0" step="1" required
						       style="width: 90px; padding: 4px;"/>
					</label>
					<button type="submit">Add</button>
				</form>
			</section>

			<p style="margin-top: 32px;"><a href="/counter">Counter</a> · <a href="/">Back to shop</a></p>
		</body>
	</html>
}

templ ServiceRow(s domain.Service) {
	<tr id={ fmt.Sprintf("service-%d", s.ID) }>
		<td>{ fmt.Sprintf("%d", s.ID) }</td>
		<td>
			<input type="text"
			       name="name"
			       form={ fmt.Sprintf("form-%d", s.ID) }
			       value={ s.Name }
			       required/>
		</td>
		<td>
			<input type="number"
			       name="price_pesos"
			       form={ fmt.Sprintf("form-%d", s.ID) }
			       value={ fmt.Sprintf("%d", s.PriceCentavos/100) }
			       min="0"
			       step="1"
			       required/>
		</td>
		<td>{ s.FormatPrice() }</td>
		<td>
			<form id={ fmt.Sprintf("form-%d", s.ID) }
			      hx-post={ fmt.Sprintf("/admin/services/%d", s.ID) }
			      hx-target={ fmt.Sprintf("#service-%d", s.ID) }
			      hx-swap="outerHTML">
				<button type="submit">Save</button>
			</form>
		</td>
	</tr>
}