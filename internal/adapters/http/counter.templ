package http

import (
	"fmt"

	"barbershop/internal/domain"
)

templ CounterPage(admin domain.User, barbers []domain.User, services []domain.Service, haircuts []domain.Haircut, barberName map[int]string, serviceName map[int]string, errorMsg string) {
	<!DOCTYPE html>
	<html>
		<head>
			<title>Counter — Barbershop</title>
			<style>
				body { font-family: sans-serif; max-width: 1000px; margin: 40px auto; }
				.topbar { text-align: right; margin-bottom: 20px; }
				.topbar form { display: inline; margin: 0; padding: 0; }
				.topbar button { background: none; border: none; color: #0000ee;
				                 text-decoration: underline; cursor: pointer;
				                 font: inherit; padding: 0; }
				table { border-collapse: collapse; width: 100%; margin-top: 16px; }
				th, td { border: 1px solid #ccc; padding: 8px; text-align: left; vertical-align: middle; }
				.error { color: #b00020; margin: 12px 0; }
				.pay { display: flex; gap: 20px; align-items: center; margin: 8px 0; flex-wrap: wrap; }
				.pay label { display: flex; gap: 6px; align-items: center; }
				.pay input[type=number] { width: 100px; padding: 4px; }
				.pay input[type=text] { padding: 4px; }
				.section { margin-top: 32px; }
				small { color: #666; }
			</style>
		</head>
		<body>
			<div class="topbar">
				<span>{ admin.FullName }</span>
				<form method="post" action="/logout">
					<button type="submit">Logout</button>
				</form>
			</div>

			<h1>Counter</h1>
			<p>Record a haircut.</p>

			if errorMsg != "" {
				<p class="error">{ errorMsg }</p>
			}

			<form method="post" action="/counter/haircuts">
				<label>
					Barber
					<select name="barber_id" required>
						for _, b := range barbers {
							<option value={ fmt.Sprintf("%d", b.ID) }>{ b.FullName }</option>
						}
					</select>
				</label>

				<label style="margin-left: 20px;">
					Service
					<select name="service_id" required>
						for _, s := range services {
							<option value={ fmt.Sprintf("%d", s.ID) }>
								{ s.Name } — { s.FormatPrice() }
							</option>
						}
					</select>
				</label>

				<p style="margin-top: 16px;">Discount (optional):</p>
				<div class="pay">
					<label>₱ <input type="number" name="discount_pesos" min="0" step="1" value="0"/></label>
					<label>Reason <input type="text" name="discount_reason" placeholder="Student, Senior, VIP, ..." style="width: 240px;"/></label>
				</div>

				<p style="margin-top: 16px;">Payment (fill in what was paid — one or more):</p>
				<div class="pay">
					<label>GCash ₱ <input type="number" name="pay_gcash" min="0" step="1" value="0"/></label>
					<label>Maribank ₱ <input type="number" name="pay_maribank" min="0" step="1" value="0"/></label>
					<label>Cash ₱ <input type="number" name="pay_cash" min="0" step="1" value="0"/></label>
				</div>

				<button type="submit" style="margin-top: 12px;">Record haircut</button>
			</form>

			<section class="section">
				<h2>Today</h2>

				if len(haircuts) == 0 {
					<p>No haircuts recorded yet today.</p>
				} else {
					<table>
						<tr>
							<th style="width: 70px;">Time</th>
							<th>Barber</th>
							<th>Service</th>
							<th style="width: 90px;">Price</th>
							<th style="width: 130px;">Discount</th>
							<th style="width: 90px;">Net</th>
							<th>Payments</th>
						</tr>
						for _, h := range haircuts {
							<tr>
								<td>{ h.CreatedAt.Format("15:04") }</td>
								<td>{ barberName[h.BarberID] }</td>
								<td>{ serviceName[h.ServiceID] }</td>
								<td>{ domain.FormatCentavos(h.PriceCentavos) }</td>
								<td>
									if h.DiscountCentavos > 0 {
										{ domain.FormatCentavos(h.DiscountCentavos) }
										if h.DiscountReason != "" {
											<br/><small>({ h.DiscountReason })</small>
										}
									} else {
										—
									}
								</td>
								<td>{ domain.FormatCentavos(h.NetCentavos) }</td>
								<td>
									if len(h.Payments) == 0 {
										<small>(free)</small>
									} else {
										for i, p := range h.Payments {
											if i > 0 {
												<br/>
											}
											{ string(p.Method) }: { domain.FormatCentavos(p.AmountCentavos) }
										}
									}
								</td>
							</tr>
						}
					</table>
				}
			</section>

			<p style="margin-top: 32px;"><a href="/admin">Admin panel</a> · <a href="/">Back to shop</a></p>
		</body>
	</html>
}