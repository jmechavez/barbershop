package http

import (
	"fmt"

	"barbershop/internal/domain"
)

templ CounterPage(
	admin domain.User,
	barbers []domain.User,
	services []domain.Service,
	haircuts []domain.Haircut,
	barberName map[int]string,
	serviceName map[int]string,
	errorMsg string,
) {
	<!DOCTYPE html>
	<html>
			<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>Something · DRFT Barbershop</title>
		<meta name="theme-color" content="#000000"/>
		<link rel="icon" type="image/png" href="/static/favicon.png"/>
		<link rel="stylesheet" href="/static/style.css"/>
	</head>
		<body class="app-page">
			<div class="app-shell">

				<nav class="app-nav">
					<a href="/" class="app-nav-brand">DRFT</a>
					<div class="app-nav-tabs">
						<a href="/admin">Admin</a>
						<a href="/counter" class="active">Counter</a>
						<a href="/admin/haircuts">Haircuts</a>
						<a href="/admin/cash-advances">Advances</a>
					</div>
					<div class="app-nav-user">
						<span>{ admin.FullName }</span>
						<form method="post" action="/logout">
							<button type="submit">Logout</button>
						</form>
					</div>
				</nav>

				<main class="app-main">

					<header class="app-header">
						<h1 class="app-title">Counter</h1>
						<p class="app-sub">Record a haircut</p>
					</header>

					<section class="panel">
						<div class="panel-head">
							<h2 class="panel-title">New haircut</h2>
						</div>
						<div class="panel-body">

							if errorMsg != "" {
								<p class="error">{ errorMsg }</p>
							}

							<form method="post" action="/counter/haircuts" class="counter-form">

								<div class="form-row">
									<label class="inline-label">
										<span>Barber</span>
										<select name="barber_id" required>
											for _, b := range barbers {
												<option value={ fmt.Sprintf("%d", b.ID) }>{ b.FullName }</option>
											}
										</select>
									</label>

									<label class="inline-label">
										<span>Service</span>
										<select name="service_id" required>
											for _, s := range services {
												<option value={ fmt.Sprintf("%d", s.ID) }>
													{ s.Name } — { s.FormatPrice() }
												</option>
											}
										</select>
									</label>
								</div>

								<div class="form-row">
									<label class="inline-label">
										<span>Discount (₱)</span>
										<input type="number" name="discount_pesos" min="0" step="1" value="0"/>
									</label>

									<label class="inline-label inline-label-grow">
										<span>Discount reason</span>
										<input type="text" name="discount_reason" placeholder="Student, Senior, VIP..."/>
									</label>
								</div>

								<div class="form-row form-row-payments">
									<label class="inline-label">
										<span>GCash (₱)</span>
										<input type="number" name="pay_gcash" min="0" step="1" value="0"/>
									</label>

									<label class="inline-label">
										<span>Maribank (₱)</span>
										<input type="number" name="pay_maribank" min="0" step="1" value="0"/>
									</label>

									<label class="inline-label">
										<span>Cash (₱)</span>
										<input type="number" name="pay_cash" min="0" step="1" value="0"/>
									</label>
								</div>

								<div class="form-actions">
									<button type="submit">Record haircut</button>
								</div>

							</form>
						</div>
					</section>

					<section class="panel">
						<div class="panel-head">
							<h2 class="panel-title">Today</h2>
							<p class="panel-sub">
								{ fmt.Sprintf("%d", len(haircuts)) } haircuts · net { domain.FormatCentavos(domain.SumNetCentavos(haircuts)) }
							</p>
						</div>

						if len(haircuts) == 0 {
							<div class="empty-state">
								<p>No haircuts recorded yet today.</p>
							</div>
						} else {
							<table class="data-table">
								<thead>
									<tr>
										<th style="width: 80px;">Time</th>
										<th>Barber</th>
										<th>Service</th>
										<th style="width: 100px;">Price</th>
										<th style="width: 130px;">Discount</th>
										<th style="width: 100px;">Net</th>
										<th>Payments</th>
									</tr>
								</thead>
								<tbody>
									for _, h := range haircuts {
										<tr>
											<td class="data-mono">{ h.CreatedAt.Format("15:04") }</td>
											<td>{ barberName[h.BarberID] }</td>
											<td>{ serviceName[h.ServiceID] }</td>
											<td>{ domain.FormatCentavos(h.PriceCentavos) }</td>
											<td>
												if h.DiscountCentavos > 0 {
													<span class="data-strong">{ domain.FormatCentavos(h.DiscountCentavos) }</span>
													if h.DiscountReason != "" {
														<br/><small>({ h.DiscountReason })</small>
													}
												} else {
													<span class="data-dim">—</span>
												}
											</td>
											<td class="data-strong">{ domain.FormatCentavos(h.NetCentavos) }</td>
											<td>
												if len(h.Payments) == 0 {
													<small>free</small>
												} else {
													for i, p := range h.Payments {
														if i > 0 {
															<br/>
														}
														<span class="pay-tag">{ string(p.Method) }</span>
														{ domain.FormatCentavos(p.AmountCentavos) }
													}
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</section>

				</main>
			</div>
		</body>
	</html>
}