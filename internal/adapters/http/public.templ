package http

import (
	"fmt"

	"barbershop/internal/domain"
)

templ PublicPage(services []domain.Service, user domain.User, loggedIn bool) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>DRFT Barbershop — General Santos City</title>
			<meta name="description" content="Clean fades, sharp lines, solid cuts. Walk-ins welcome, open daily 10AM–9PM. Purok Carmenville Rd, Calumpang, General Santos City."/>
			<meta name="theme-color" content="#000000"/>
			<!-- Favicon -->
			<link rel="icon" type="image/png" href="/static/favicon.png"/>
			<link rel="apple-touch-icon" href="/static/favicon.png"/>
			<!-- Open Graph (Facebook, Messenger, Viber, WhatsApp) -->
			<meta property="og:type" content="website"/>
			<meta property="og:title" content="DRFT Barbershop — General Santos City"/>
			<meta property="og:description" content="Clean fades, sharp lines, solid cuts. Walk-ins welcome, open daily."/>
			<meta property="og:image" content="https://drftbarbershop.com/static/hero.png"/>
			<meta property="og:url" content="https://drftbarbershop.com/"/>
			<!-- Twitter / X -->
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content="DRFT Barbershop — General Santos City"/>
			<meta name="twitter:description" content="Clean fades, sharp lines, solid cuts. Walk-ins welcome, open daily."/>
			<meta name="twitter:image" content="https://drftbarbershop.com/static/hero.png"/>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.3"></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body class="fade-in">
			<!-- Nav -->
			<nav class="nav-band" id="topnav">
				<div class="nav-inner">
					<div class="nav-brand">DRFT</div>
					<button class="nav-toggle" aria-label="Menu" onclick="document.getElementById('topnav').classList.toggle('open')">
						<span></span><span></span><span></span>
					</button>
					<div class="nav-links">
						<a href="#about">About</a>
						<a href="#reviews">Reviews</a>
						<a href="#menu">Menu</a>
						if loggedIn {
							if user.Role == domain.RoleAdmin {
								<a href="/admin">Admin</a>
								<a href="/counter">Counter</a>
							} else {
								<a href="/me">My page</a>
								<a href="/me/salary">Salary</a>
							}
							<form method="post" action="/logout">
								<button type="submit">Logout</button>
							</form>
						} else {
							<a href="/login">Login</a>
						}
					</div>
				</div>
			</nav>
			<!-- Hero -->
			<section class="hero-band hero-band-photo">
				<div class="hero-overlay"></div>
				<div class="hero-inner">
					<img src="/static/logo.png" alt="DRFT Barbershop" class="hero-logo"/>
					<p class="hero-line">Dili lang gupit.<br/><strong>Lahi ang porma.</strong></p>
					<a href="#menu" class="btn-hero">View menu ↓</a>
				</div>
			</section>
			<!-- Text panel 1 -->
			<section class="text-band" id="about">
				<div class="text-band-inner">
					<p>
						Sa <strong><em>DRFT Barbershop</em></strong>, <strong>clean fade, sharp lines, ug fresh ka pirmi.</strong>
						Atong mga barber kabalo mohatag og solid nga porma, walay tinapulan, walay sablay.
						<strong>Kung limpyo nga gupit imong gipangita, ari na.</strong>
					</p>
				</div>
			</section>
			<!-- Wide visual band (photo slot for later) -->
			<section class="wide-band wide-band-photo" aria-hidden="true"></section>
			<!-- Text panel 2 -->
			<section class="text-band">
				<div class="text-band-inner">
					<p>
						Dili lang mi basta nag-gupit, <strong>gihimo namo og tarong ang imong porma.</strong>
						Chill nga vibe, solid nga serbisyo, ug presyong klaro.
						Sulod nga chill, lingkod sa chair, then <strong>gawas nga fresh.</strong>
					</p>
				</div>
			</section>
			<!-- Testimonials -->
			<section class="testimonials-band" id="reviews">
				<div class="testimonials-inner">
					<h2>What customers say</h2>
					<div class="testimonial-grid">
						<div class="testimonial">
							<p class="testimonial-quote">
								Goods kay kaayo ka barbero! Limpyo kaayo ang fade, solid ang porma. 🔥
							</p>
							<p class="testimonial-name">— Samuel D.</p>
						</div>
						<div class="testimonial">
							<p class="testimonial-quote">
								Limpyo kaayo mo-gupit, astig ang resulta. Balik-balik gyud ko diri! 🔥
							</p>
							<p class="testimonial-name">— Reneboy Q.</p>
						</div>
						<div class="testimonial">
							<p class="testimonial-quote">
								Sulit kaayo! Limpyo ang gupit, tarong ang barber, ug fresh gyud pag-gawas. 🔥
							</p>
							<p class="testimonial-name">— John E.</p>
						</div>
					</div>
				</div>
			</section>
			<!-- Menu -->
			<section class="menu-band" id="menu">
				<div class="menu-inner">
					<form id="pick" hx-post="/pick" hx-target="#total-amount" hx-swap="innerHTML">
						<h2>Haircuts</h2>
						<div class="svc-list">
							for _, s := range services {
								if s.Category == "haircut" {
									<label class="svc-row">
										<input type="checkbox" name="service" value={ fmt.Sprintf("%d", s.PriceCentavos) }/>
										<div class="svc-left">
											<p class="svc-name">{ s.Name }</p>
										</div>
										<div class="svc-price">{ s.FormatPrice() }</div>
									</label>
								}
							}
						</div>
						<h2>Signature Packages</h2>
						<div class="svc-list">
							for _, s := range services {
								if s.Category == "package" {
									<label class="svc-row">
										<input type="checkbox" name="service" value={ fmt.Sprintf("%d", s.PriceCentavos) }/>
										<div class="svc-left">
											<p class="svc-name">{ s.Name }</p>
										</div>
										<div class="svc-price">{ s.FormatPrice() }</div>
									</label>
								}
							}
						</div>
						<div class="total-bar">
							<div>
								<div class="label">Total</div>
								<div class="amount" id="total-amount">₱0</div>
							</div>
							<button type="submit">Update</button>
						</div>
					</form>
				</div>
			</section>
			<!-- Closing line -->
			<section class="closing-band">
				<p>
					Walk-ins welcome. Message us on
					<a href="https://www.facebook.com/drftbarbershop" target="_blank" rel="noopener noreferrer">Facebook</a>
					to book a slot.
				</p>
			</section>
			<!-- Footer -->
			<footer class="site-footer">
				<div class="footer-inner">
					<div class="footer-brand">
						<img src="/static/logo.png" alt="DRFT Barbershop" class="footer-logo"/>
						<p class="footer-tagline">Fresh Cut · Clean Look · Drft Style</p>
						<div class="footer-socials">
							<a href="https://www.facebook.com/drftbarbershop" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path>
								</svg>
							</a>
							<a href="https://www.instagram.com/drftbarbershop" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
									<circle cx="12" cy="12" r="4"></circle>
									<circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"></circle>
								</svg>
							</a>
							<a href="https://www.tiktok.com/@drftbarbershop" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.66a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.09z"></path>
								</svg>
							</a>
						</div>
					</div>
					<div class="footer-cols">
						<div class="footer-col">
							<h4 class="footer-heading">Visit</h4>
							<p>Purok Carmenville Rd<br/>General Santos City</p>
						</div>
						<div class="footer-col">
							<h4 class="footer-heading">Contact</h4>
							<p>
								<a href="tel:+639952765856">0995 276 5856</a>
								<br/>
								<a href="mailto:info@drftbarbershop.com">info@drftbarbershop.com</a>
							</p>
						</div>
						<div class="footer-col">
							<h4 class="footer-heading">Hours</h4>
							<p>
								Open daily
								<br/>
								10:00 AM – 9:00 PM
							</p>
						</div>
						<div class="footer-col">
							<h4 class="footer-heading">Sister Shop</h4>
							<p>
								<a href="https://driftculture.com" target="_blank" rel="noopener noreferrer">
									Drift Culture ↗
								</a>
								<br/>
								<small>Vape shop</small>
							</p>
						</div>
					</div>
					<div class="footer-bottom">
						<p>© 2026 DRFT Barbershop. All rights reserved.</p>
						<p><a href="/login">Staff login</a></p>
					</div>
				</div>
			</footer>
		</body>
	</html>
}
