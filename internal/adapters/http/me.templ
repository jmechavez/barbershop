package http

import (
	"fmt"

	"barbershop/internal/domain"
)

templ MePage(user domain.User, haircuts []domain.Haircut, serviceName map[int]string, advances []domain.CashAdvance) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Something · DRFT Barbershop</title>
			<meta name="theme-color" content="#000000"/>
			<link rel="icon" type="image/png" href="/static/favicon.png"/>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body class="app-page">
			<div class="app-shell">
				<nav class="app-nav">
					<a href="/" class="app-nav-brand">DRFT</a>
					<div class="app-nav-tabs">
						<a href="/me" class="active">My page</a>
						<a href="/me/salary">Salary</a>
					</div>
					<div class="app-nav-user">
						<span>{ user.FullName }</span>
						<form method="post" action="/logout">
							<button type="submit">Logout</button>
						</form>
					</div>
				</nav>
				<main class="app-main">
					<header class="app-header">
						<h1 class="app-title">Hello, { user.FullName }</h1>
						<p class="app-sub">Today at a glance</p>
					</header>
					<!-- Stats -->
					<section class="stats-row">
						<div class="stat-card">
							<div class="stat-label">Haircuts</div>
							<div class="stat-value">{ fmt.Sprintf("%d", len(haircuts)) }</div>
						</div>
						<div class="stat-card">
							<div class="stat-label">List total</div>
							<div class="stat-value">{ domain.FormatCentavos(domain.SumListCentavos(haircuts)) }</div>
						</div>
						<div class="stat-card">
							<div class="stat-label">Net collected</div>
							<div class="stat-value">{ domain.FormatCentavos(domain.SumNetCentavos(haircuts)) }</div>
						</div>
						<div class="stat-card">
							<div class="stat-label">Advances (30d)</div>
							<div class="stat-value">{ domain.FormatCentavos(domain.SumAdvances(advances)) }</div>
						</div>
					</section>
					<!-- Today's haircuts -->
					<section class="panel">
						<div class="panel-head">
							<h2 class="panel-title">Today</h2>
							<p class="panel-sub">
								{ fmt.Sprintf("%d", len(haircuts)) } haircuts · net { domain.FormatCentavos(domain.SumNetCentavos(haircuts)) }
							</p>
						</div>
						if len(haircuts) == 0 {
							<div class="empty-state">
								<p>No haircuts recorded yet today.</p>
							</div>
						} else {
							<table class="data-table">
								<thead>
									<tr>
										<th style="width: 80px;">Time</th>
										<th>Service</th>
										<th style="width: 100px;">Price</th>
										<th style="width: 130px;">Discount</th>
										<th style="width: 100px;">Net</th>
										<th>Payments</th>
									</tr>
								</thead>
								<tbody>
									for _, h := range haircuts {
										<tr>
											<td class="data-mono">{ h.CreatedAt.Format("15:04") }</td>
											<td>{ serviceName[h.ServiceID] }</td>
											<td>{ domain.FormatCentavos(h.PriceCentavos) }</td>
											<td>
												if h.DiscountCentavos > 0 {
													<span class="data-strong">{ domain.FormatCentavos(h.DiscountCentavos) }</span>
													if h.DiscountReason != "" {
														<br/>
														<small>({ h.DiscountReason })</small>
													}
												} else {
													<span class="data-dim">—</span>
												}
											</td>
											<td class="data-strong">{ domain.FormatCentavos(h.NetCentavos) }</td>
											<td>
												if len(h.Payments) == 0 {
													<small>free</small>
												} else {
													for i, p := range h.Payments {
														if i > 0 {
															<br/>
														}
														<span class="pay-tag">{ string(p.Method) }</span>
														{ domain.FormatCentavos(p.AmountCentavos) }
													}
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</section>
					<!-- Cash advances -->
					<section class="panel">
						<div class="panel-head">
							<h2 class="panel-title">Cash advances</h2>
							<p class="panel-sub">Last 30 days · total { domain.FormatCentavos(domain.SumAdvances(advances)) }</p>
						</div>
						if len(advances) == 0 {
							<div class="empty-state">
								<p>No cash advances in the last 30 days.</p>
							</div>
						} else {
							<table class="data-table">
								<thead>
									<tr>
										<th style="width: 160px;">Date</th>
										<th style="width: 120px;">Amount</th>
										<th>Note</th>
									</tr>
								</thead>
								<tbody>
									for _, a := range advances {
										<tr>
											<td class="data-dim">{ a.TakenAt.Format("Jan 2, 2006") }</td>
											<td class="data-strong">{ domain.FormatCentavos(a.AmountCentavos) }</td>
											<td>{ a.Note }</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</section>
				</main>
			</div>
		</body>
	</html>
}
