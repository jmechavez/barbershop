package http

import (
	"fmt"

	"barbershop/internal/domain"
)

templ AdminHome(user domain.User, services []domain.Service) {
	<!DOCTYPE html>
	<html>
		<head>
			<title>Admin — Barbershop</title>
			<script src="https://unpkg.com/htmx.org@2.0.3"></script>
			<style>
				body { font-family: sans-serif; max-width: 900px; margin: 40px auto; }
				table { border-collapse: collapse; width: 100%; margin-top: 16px; }
				th, td { border: 1px solid #ccc; padding: 8px; text-align: left; vertical-align: middle; }
				input[type=text] { width: 100%; box-sizing: border-box; padding: 4px; }
				input[type=number] { width: 90px; padding: 4px; }
			</style>
		</head>
		<body>
			<h1>Admin</h1>
			<p>Signed in as { user.Email } ({ string(user.Role) })</p>

			<h2>Services</h2>
			<table>
				<tr>
					<th style="width: 40px;">ID</th>
					<th>Name</th>
					<th style="width: 120px;">Price</th>
					<th style="width: 120px;">Formatted</th>
					<th style="width: 90px;"></th>
				</tr>
				for _, s := range services {
					@ServiceRow(s)
				}
			</table>

			<h2>Add a service</h2>
			<form method="post" action="/admin/services">
				<label>
					Name
					<input type="text" name="name" required
					       style="width: 200px; box-sizing: border-box; padding: 4px;"/>
				</label>
				<label>
					Price (pesos)
					<input type="number" name="price_pesos" min="0" step="1" required
					       style="width: 90px; padding: 4px;"/>
				</label>
				<button type="submit">Add</button>
			</form>

			<p style="margin-top: 32px;"><a href="/">Back to shop</a></p>
		</body>
	</html>
}

templ ServiceRow(s domain.Service) {
	<tr id={ fmt.Sprintf("service-%d", s.ID) }>
		<td>{ fmt.Sprintf("%d", s.ID) }</td>
		<td>
			<input type="text"
			       name="name"
			       form={ fmt.Sprintf("form-%d", s.ID) }
			       value={ s.Name }
			       required/>
		</td>
		<td>
			<input type="number"
			       name="price_pesos"
			       form={ fmt.Sprintf("form-%d", s.ID) }
			       value={ fmt.Sprintf("%d", s.PriceCentavos/100) }
			       min="0"
			       step="1"
			       required/>
		</td>
		<td>{ domain.FormatCentavos(s.PriceCentavos) }</td>
		<td>
			<form id={ fmt.Sprintf("form-%d", s.ID) }
			      hx-post={ fmt.Sprintf("/admin/services/%d", s.ID) }
			      hx-target={ fmt.Sprintf("#service-%d", s.ID) }
			      hx-swap="outerHTML">
				<button type="submit">Save</button>
			</form>
		</td>
	</tr>
}